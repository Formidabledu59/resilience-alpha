{
  "uid": "resilience-frontal-securite",
  "title": "Resilience - Frontal et sécurité",
  "description": "Audience anonyme du frontal (journaux nginx sans IP), erreurs, rate-limit, échecs de connexion et transactions refusées.",
  "tags": ["resilience", "frontal", "securite"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "bargauge",
      "title": "Pages vues sur la période",
      "description": "Mesure d'audience sans cookie : journaux du frontal, sans adresse IP.",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (path) (count_over_time({service=\"frontend\"} | json | status=\"200\" | path=~\"^/(confidentialite|cgu)?/?$\" [$__range]))",
          "queryType": "instant",
          "legendFormat": "{{path}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#2a78d6" }, "decimals": 0, "min": 0 }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Pages vues dans le temps",
      "gridPos": { "x": 8, "y": 0, "w": 16, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({service=\"frontend\"} | json | status=\"200\" | path=~\"^/(confidentialite|cgu)?/?$\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "Pages vues"
        }
      ],
      "options": { "legend": { "showLegend": false }, "tooltip": { "mode": "single" } },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#2a78d6" }, "custom": { "lineWidth": 2, "fillOpacity": 0 }, "decimals": 0, "min": 0 }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Échecs de connexion (auth-service, HTTP 401)",
      "description": "Une hausse brutale peut signaler une attaque par force brute.",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({service=\"auth-service\"} |= \"POST /auth/token\" |= \" 401\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "Échecs"
        }
      ],
      "options": { "legend": { "showLegend": false }, "tooltip": { "mode": "single" } },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#2a78d6" }, "custom": { "lineWidth": 2 }, "decimals": 0, "min": 0 }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Requêtes limitées par le frontal (HTTP 429)",
      "description": "Rate-limit du nginx du frontal (connexion : 10 par minute, API : 10 par seconde).",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({service=\"frontend\"} | json | status=\"429\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "Requêtes limitées"
        }
      ],
      "options": { "legend": { "showLegend": false }, "tooltip": { "mode": "single" } },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#2a78d6" }, "custom": { "lineWidth": 2 }, "decimals": 0, "min": 0 }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Transactions refusées (solde insuffisant)",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(payment_transactions_total{status=\"REJECTED\"}[1m]))",
          "legendFormat": "Refusées par seconde"
        }
      ],
      "options": { "legend": { "showLegend": false }, "tooltip": { "mode": "single" } },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#2a78d6" }, "custom": { "lineWidth": 2 }, "unit": "reqps", "min": 0 }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Adresses introuvables (HTTP 404)",
      "description": "Liens cassés ou exploration automatique : à surveiller.",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "topk(20, sum by (path) (count_over_time({service=\"frontend\"} | json | status=\"404\" [$__range])))",
          "queryType": "instant",
          "legendFormat": "{{path}}"
        }
      ],
      "transformations": [{ "id": "reduce", "options": { "reducers": ["lastNotNull"] } }],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Journaux du frontal et d'auth-service",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service=~\"frontend|auth-service\"}",
          "queryType": "range"
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none" }
    }
  ]
}
