# =============================================================================
# PROJECT RESILIENCE-ALPHA — modèle de variables d'environnement
# =============================================================================
# 1. Copier ce fichier en .env (ignoré par Git, ne JAMAIS le commiter).
# 2. Remplacer toutes les valeurs changeme_* par des secrets aléatoires
#    (procédure PowerShell dans infra/README.md).
# Les valeurs ci-dessous sont factices et ne doivent servir nulle part.

# --- Réseau ------------------------------------------------------------------
# IP du PC Hôte sur le point d'accès RESILIENCE-G16 (seule IP où le WAF publie le port 80).
# Ne jamais mettre 0.0.0.0 : le PC est aussi sur le WiFi du campus.
WAF_BIND_IP=192.168.137.1

# --- Grafana (http://127.0.0.1:3000) -----------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_grafana

# --- PostgreSQL (données métier fictives) ------------------------------------
POSTGRES_DB=payments
POSTGRES_USER=payments_app
POSTGRES_PASSWORD=changeme_db

# --- Vault -------------------------------------------------------------------
# Adresse interne (data-net). Les tokens Vault ne sont pas stockés ici.
VAULT_ADDR=http://vault:8200

# --- Moteur de remédiation ---------------------------------------------------
# Secret partagé pour signer (HMAC) les alertes de ml-detector.
REMEDIATION_HMAC_SECRET=changeme_hmac
# Token envoyé par Alertmanager (en-tête Authorization: Bearer).
REMEDIATION_BEARER_TOKEN=changeme_token

# --- Sonde canari ------------------------------------------------------------
# Intervalle entre deux transactions fictives, en secondes.
CANARY_INTERVAL_SECONDS=5

# --- Détecteur ML ------------------------------------------------------------
# Seuil du score d'anomalie (Isolation Forest) au-delà duquel une alerte est envoyée.
ML_ANOMALY_THRESHOLD=0.7

# --- Ollama (natif, hors Docker) ---------------------------------------------
# PC Hôte : http://host.docker.internal:11434
# PC délestage IA : http://192.168.137.x:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Modèle de 8 milliards de paramètres au maximum.
OLLAMA_MODEL=llama3.1:8b
