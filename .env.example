# =============================================================================
# PROJECT RESILIENCE-ALPHA — modèle de variables d'environnement
# =============================================================================
# 1. Copier ce fichier en .env (ignoré par Git, ne JAMAIS le commiter).
# 2. Remplacer toutes les valeurs changeme_* par des secrets aléatoires
#    (procédure PowerShell dans infra/README.md).
# Les valeurs ci-dessous sont factices et ne doivent servir nulle part.

# --- Réseau ------------------------------------------------------------------
# IP du PC Hôte sur le point d'accès RESILIENCE-G16 (seule IP où le WAF publie le port 80).
# Ne jamais mettre 0.0.0.0 : le PC est aussi sur le WiFi du campus.
# Sans point d'accès actif (développement sur le PC Hôte seul) : WAF_BIND_IP=127.0.0.1
WAF_BIND_IP=192.168.137.1

# --- WAF : rate-limit par client ---------------------------------------------
# Débit autorisé par client et rafale tolérée au-delà (429 ensuite).
WAF_RATE_LIMIT=50r/s
WAF_RATE_BURST=100

# --- Frontal : rate-limit /api par client ------------------------------------
# Deuxième limite après celle du WAF. Valeurs nominales ci-dessous ; à relâcher
# (ex. 1000r/s et 2000) pour que l'attaque DoS atteigne payment-api pendant la démo.
FRONTEND_API_RATE_LIMIT=10r/s
FRONTEND_API_BURST=20

# --- Dashboard : porte biométrique du back-office (consigne additionnelle 1) --
# Préparée mais désactivée pour la démonstration. true : identifiant -> visage -> mot de passe
# (passerelle biometrics/gateway lancée sur le PC Hôte) ; false : supervision affichée directement.
BACKOFFICE_BIOMETRICS=false

# --- Grafana (http://127.0.0.1:3000) -----------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_grafana

# --- PostgreSQL (données métier fictives) ------------------------------------
POSTGRES_DB=payments
POSTGRES_USER=payments_app
POSTGRES_PASSWORD=changeme_db

# --- Authentification (auth-service, payment-api, canary) --------------------
# Clé de signature des JWT (HS256), partagée par auth-service et payment-api.
# Avec le profile security, elle est copiée dans Vault et lue depuis Vault.
JWT_SECRET=changeme_jwt
# Mots de passe des utilisateurs fictifs "demo" et "canary".
AUTH_DEMO_PASSWORD=changeme_demo
AUTH_CANARY_PASSWORD=changeme_canary

# --- Vault -------------------------------------------------------------------
# Adresse interne (data-net). Les tokens Vault ne sont pas stockés ici.
VAULT_ADDR=http://vault:8200

# --- Moteur de remédiation ---------------------------------------------------
# Secret partagé pour signer (HMAC) les alertes de ml-detector.
REMEDIATION_HMAC_SECRET=changeme_hmac
# Token envoyé par Alertmanager (en-tête Authorization: Bearer).
REMEDIATION_BEARER_TOKEN=changeme_token

# --- Sonde canari ------------------------------------------------------------
# Intervalle entre deux transactions fictives, en secondes.
CANARY_INTERVAL_SECONDS=5

# --- Détecteur ML ------------------------------------------------------------
# Seuil du score d'anomalie (Isolation Forest) au-delà duquel une alerte est envoyée.
ML_ANOMALY_THRESHOLD=0.7
# Relevés consécutifs (toutes les 5 s) au-dessus du seuil avant d'alerter. 2 = détection ~5 s
# plus rapide (utile pour tenir le Clip Chrono), au prix de plus de faux positifs.
ML_ALERT_CONSECUTIVE=3

# --- Ollama (natif, hors Docker) ---------------------------------------------
# PC Hôte : http://host.docker.internal:11434
# PC délestage IA : http://192.168.137.x:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Modèle de 8 milliards de paramètres au maximum.
OLLAMA_MODEL=llama3.1:8b
# Modèle d'embeddings de l'assistant RAG (à tirer aussi : ollama pull nomic-embed-text).
OLLAMA_EMBED_MODEL=nomic-embed-text
